{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/statusline.sh\""
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Read(**/.env)",
      "Read(**/.zprofile.local)",
      "Read(**/.ssh/id_*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(bun run:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(gh pr merge:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "cleanupPeriodDays": 14,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/claude-mem-pid-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/claude-mem-pid-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "theme": "auto",
  "outputStyle": "Concise",
  "editorMode": "normal",
  "teammateMode": "in-process",
  "worktree": {
    "baseRef": "fresh"
  },
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": true
}
