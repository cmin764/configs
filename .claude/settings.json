{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(bunx:*)",
      "Bash(bun add:*)",
      "Bash(bun run:*)",
      "Bash(ipconfig getifaddr:*)",
      "Bash(curl:*)",
      "WebFetch(domain:nomadsnest.live)",
      "WebFetch(domain:www.nomadsnest.live)",
      "Bash(find:*)",
      "Bash(python3:*)",
      "Bash(which vercel:*)",
      "WebFetch(domain:www.airbnb.com)",
      "WebFetch(domain:www.booking.com)",
      "WebFetch(domain:www.homeexchange.com)",
      "Bash(ls -la /Users/cmin/Work/cmin764/nomads-nest/.env*)",
      "Bash(done)",
      "Bash(wc:*)",
      "Bash(grep -o \"gold\\\\|Gold\\\\|#[0-9a-fA-F]\\\\{3,6\\\\}\\\\|--.*color\" \"/Users/cmin/Projects/Nomad''''s Nest/Site/Nomad''''s Nest_files/site.css\")",
      "Bash(ls -lh \"/Users/cmin/Projects/Nomad''''s Nest/Site/\"*files/*.jpg)",
      "Bash(grep -v \"^f_\\\\|^noscript_\\\\|\\\\.webp$\")",
      "Bash(grep -E '\\\\.\\(jpg|JPG|jpeg|png|webp|mp4\\)$')",
      "Bash(grep -E '\\\\.\\(jpg|JPG|jpeg|png|webp\\)$')",
      "Bash(bash scripts/download-media.sh)",
      "WebSearch",
      "WebFetch(domain:simpleicons.org)",
      "Bash(git log:*)",
      "Bash(grep -rn --include=*.ts --include=*.tsx --include=*.js --include=*.mjs --include=*.json -E \"\\(api[_-]?key|apikey|secret|password|passwd|token|bearer|private[_-]?key|access[_-]?key|auth[_-]?token\\)\\\\s*[:=]\\\\s*[''''][^'''']{8,}\" --exclude-dir=node_modules --exclude-dir=.next)",
      "Bash(bun audit:*)",
      "WebFetch(domain:cdn.simpleicons.org)",
      "Read(//Users/cmin/Pictures/Airbnb/Home/**)",
      "Bash(sips:*)",
      "Read(//Users/cmin/Work/cmin764/wandercode/public/logos/**)",
      "Read(//Users/cmin/Work/cmin764/wandercode/public/**)",
      "Bash(identify /Users/cmin/Work/cmin764/wandercode/public/favicon.ico)",
      "WebFetch(domain:evilmartians.com)",
      "WebFetch(domain:favicon.io)",
      "Bash(gh search:*)",
      "Bash(gh repo:*)",
      "Bash(grep:*)",
      "Bash(cat \"/Users/cmin/Projects/NomadsNest/Site/Terms & Conditions — Nomad''''s Nest.htm\")",
      "Read(//tmp/**)",
      "Bash(identify /tmp/contact-hq.jpg)",
      "WebFetch(domain:unsplash.com)",
      "WebFetch(domain:react-photo-album.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:flickr.github.io)",
      "Bash(route get:*)",
      "Bash(networksetup:*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-mem-pid-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/claude-mem-pid-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "model": "sonnet",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
